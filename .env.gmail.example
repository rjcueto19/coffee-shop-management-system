# Copy these values into .env and fill in your Gmail credentials locally.
# Enable Google Account 2-Step Verification and create a Gmail App Password.
# Admin authenticator 2FA is mandatory; customer 2FA is optional.
APP_URL=http://127.0.0.1:8000
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD="your-16-character-app-password"
MAIL_FROM_ADDRESS="your-address@gmail.com"
MAIL_FROM_NAME="Daily Grind"
EMAIL_FEATURES_ENABLED=true

ADMIN_TWO_FACTOR_ENABLED=true
